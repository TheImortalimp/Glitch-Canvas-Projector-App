{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Glitch Canvas Projector",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe"
      },
      "args": [
        "."
      ],
      "console": "integratedTerminal",
      "outputCapture": "std"
    }
  ]
}
