{
  "name": "glitch-canvas-projector-app",
  "productName": "Glitch Canvas Projector App",
  "version": "1.0.1",
  "private": true,
  "description": "Live screen and window projection with the Glitch Canvas effects engine",
  "main": "src/main/main.cjs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win nsis --x64",
    "package:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "22.1.0"
  },
  "build": {
    "appId": "nl.imortalimp.glitchcanvasprojector",
    "productName": "Glitch Canvas Projector App",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "SECURITY.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
